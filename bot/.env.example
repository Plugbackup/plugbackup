# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Все значения здесь — заглушки. Адреса взяты из диапазонов для документации.

# Токен бота от @BotFather.
BOT_TOKEN=replace-me

# Telegram id администраторов через запятую.
ADMIN_IDS=111111111,222222222
# Чат, куда уходят алерты об ошибках storectl, недоступных нодах и сбоях платежей.
ADMIN_CHAT_ID=111111111

# Файл базы SQLite. На VPS: /var/lib/plugbackup-bot/bot.db
DB_PATH=data/bot.db

# Названия и объёмы тарифов берутся из design/data/plans.json.
# На VPS укажите абсолютный путь, например /opt/plugbackup/design/data/plans.json
PLANS_FILE=../design/data/plans.json
# Цены в Telegram Stars за 30 дней (от 1 до 10000). Значения — заглушки,
# подберите их по текущему курсу Stars.
PRICES_STARS='{"gb50": 50, "gb100": 100, "gb200": 170}'

# Ноды хранения. addr — адрес в WireGuard-сети, public_host — адрес для клиентов.
# oversell — коэффициент перепродажи ёмкости, 1.0 — без перепродажи.
NODES='[{"name": "node1", "addr": "192.0.2.10", "public_host": "node1.plugbackup.site", "capacity_gb": 1000, "oversell": 1.0}]'

# SSH к storectl на ноде.
SSH_USER=provision
SSH_PORT=22
SSH_KEY_PATH=/etc/plugbackup-bot/provision_ed25519
SSH_KNOWN_HOSTS_PATH=/etc/plugbackup-bot/known_hosts
STORECTL_TIMEOUT_S=20

# Кастомные эмодзи из пака (набор https://t.me/addemoji/RestrictedEmoji). Работают, только если
# у владельца бота есть Telegram Premium. Если Telegram их отклонит, бот сам перейдёт на обычные
# эмодзи и один раз напишет в админ-чат. false выключает кастомные эмодзи совсем.
USE_CUSTOM_EMOJI=true
# Баннеры экранов лежат в design/graphics/png. На VPS укажите абсолютный путь.
ASSETS_DIR=../design/graphics/png
# Эффект (конфетти) на сообщениях об оплате и выдаче доступа. Если Telegram его не примет,
# бот пришлёт сообщение без эффекта.
MESSAGE_EFFECTS=true
EMOJI_SET=RestrictedEmoji
# Файлы создаёт scripts/scan_emoji.py. emoji_map.json можно править руками.
EMOJI_PACK_FILE=emoji_pack.json
EMOJI_MAP_FILE=emoji_map.json

# Часовой пояс для тихих часов, пока клиент не выбрал свой.
DEFAULT_TZ=Europe/Moscow

LOG_LEVEL=INFO
